# Real profile: the REAL benchmark database (phones and Linux boxes).
# Only real measurements go here - imported logs or collector uploads.
# Load with `set -a; source .env.real; set +a` or `just serve-backend real`.
DATABASE_URL=sqlite://data/real/benchmarks.sqlite3
DATA_ROOT=data/real
ARTIFACT_ROOT=data/real/artifacts
MODEL_ROOT=data/real/models
TEMPORARY_DIR=data/real/temporary
TRASH_DIR=data/real/trash
# LISTEN_ADDR=127.0.0.1:3000
# DASHBOARD_DIST=dashboard/dist

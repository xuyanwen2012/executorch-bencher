# Development profile: the MOCK database. Seed it with fake runs via
# `cargo run --example seed_mock_data`; never import real results here.
# The real database lives in .env.real (`just serve-backend real`).
DATABASE_URL=sqlite://data/dev/benchmarks.sqlite3
DATA_ROOT=data/dev
ARTIFACT_ROOT=data/dev/artifacts
MODEL_ROOT=data/dev/models
TEMPORARY_DIR=data/dev/temporary
TRASH_DIR=data/dev/trash
# Optional: socket address the HTTP server binds (default 0.0.0.0:3000).
# LISTEN_ADDR=127.0.0.1:3000
# Optional: serve the built dashboard from / (run `bun run build` in dashboard/ first).
# DASHBOARD_DIST=dashboard/dist

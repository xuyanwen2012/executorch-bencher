{
  "name": "executorch-bencher-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot dev.ts",
    "build": "bun run build.ts",
    "check": "tsc --noEmit && bun run scripts/check-api-drift.ts",
    "test": "bun test",
    "generate-api": "openapi-typescript ../openapi/openapi.json -o src/api/schema.d.ts",
    "smoke": "bun run scripts/smoke.tsx",
    "live-check": "bun run scripts/live-check.ts",
    "screenshot": "bun run scripts/screenshot.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tanstack/react-query": "5.102.8",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.12.0",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "bun-plugin-tailwind": "0.1.2",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.62.1",
    "typescript": "5.9.3"
  }
}
